# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Supabase PostgreSQL connection string
# Note: special chars in password must be URL-encoded (@ → %40, # → %23, etc.)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Model version tag used when writing predictions to DB
MODEL_VERSION=v1

# FastAPI base URL (used by dashboard to call the API)
# Local dev: http://localhost:8000
# Production: https://your-app.onrender.com
API_URL=http://localhost:8000

# OpenAI API key for the RAG Q&A layer (embeddings + gpt-4o-mini)
# Get one at https://platform.openai.com/api-keys (needs a small billing balance)
OPENAI_API_KEY=sk-...

# --- AWS / RDS (Extension 2: orchestration + cloud) — see infra/aws_setup.md ---
# After migrating Supabase -> RDS, point DATABASE_URL at the RDS endpoint above.
# RDS target used by scripts/migrate_to_rds.py (kept alongside DATABASE_URL):
RDS_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_INSTANCE.rds.amazonaws.com:5432/postgres?sslmode=require
# IAM user with S3 access (boto3 in the pipeline DAG):
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=nfl-analytics-raw-your-initials
