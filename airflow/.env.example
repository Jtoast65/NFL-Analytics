# Copy to airflow/.env (gitignored) and fill in. Supplies credentials to the DAG.

# RDS target (same instance the local pipeline uses)
DATABASE_URL=postgresql://postgres:PASSWORD@RDS_ENDPOINT:5432/postgres?sslmode=require

# dbt reads these (same RDS)
DBT_HOST=RDS_ENDPOINT
DBT_USER=postgres
DBT_PASSWORD=PASSWORD
DBT_DBNAME=postgres
DBT_PORT=5432

# AWS (IAM user with S3 access — see infra/aws_setup.md step 1)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=nfl-analytics-raw-jsandoval

# RAG reindex task
OPENAI_API_KEY=sk-...

# Where the repo is mounted inside the container (see airflow/README.md)
PROJECT_DIR=/usr/local/airflow/include/nfl-analytics
